{
    "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
    "tasks": [
        {
            "name": "dotnet-test",
            "group": "pre-push",
            "command": "dotnet",
            "args": ["test", "RatBot.slnx", "--configuration", "Release"],
            "include": ["**/*.cs", "**/*.csproj", "**/*.props", "**/*.targets", "RatBot.slnx"],
            "output": "always"
        }
    ]
}