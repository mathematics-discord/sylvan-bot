---
import DefaultSiteTitle from '@astrojs/starlight/components/SiteTitle.astro';

const release = import.meta.env.DOCS_RELEASE;
---

<div class="site-brand">
    <DefaultSiteTitle>
        <slot/>
    </DefaultSiteTitle>
    {release && <span class="site-release" aria-label={`Release ${release}`}>v{release}</span>}
</div>
