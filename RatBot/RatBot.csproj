<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <AssemblyVersion>0.0.1.0</AssemblyVersion>
        <FileVersion>0.0.1.0</FileVersion>
        <InformationalVersion>0.0.1-1+Branch.master.Sha.78e787255041c4c618916f4791fcd3d7045e6f60</InformationalVersion>
        <Version>0.0.1-1</Version>
    </PropertyGroup>
    <PropertyGroup Condition="'$(BuildingInsideVisualStudio)' == 'true' and '$(Configuration)' == 'Debug'">
        <!-- Run the database check on each IDE build, even when compilation is up to date. -->
        <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    </PropertyGroup>
    <Target Name="StartLocalDatabase" BeforeTargets="Build"
            Condition="'$(BuildingInsideVisualStudio)' == 'true' and '$(Configuration)' == 'Debug' and '$(DesignTimeBuild)' != 'true'">
        <Exec Command="docker compose --env-file .env -f docker-compose.yml up -d --wait db"
              WorkingDirectory="$(MSBuildProjectDirectory)/.." />
    </Target>
    <ItemGroup>
        <PackageReference Include="Dapper"/>
        <PackageReference Include="DiffPlex"/>
        <PackageReference Include="Discord.Net.Interactions"/>
        <PackageReference Include="Discord.Net.WebSocket"/>
        <PackageReference Include="DotNetEnv"/>
        <PackageReference Include="ErrorOr"/>
        <PackageReference Include="JetBrains.Annotations"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
        <PackageReference Include="Microsoft.Extensions.Hosting"/>
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL"/>
        <PackageReference Include="Serilog"/>
        <PackageReference Include="Serilog.Extensions.Hosting"/>
        <PackageReference Include="Serilog.Sinks.Console"/>
        <PackageReference Include="Serilog.Sinks.File"/>
    </ItemGroup>
</Project>
