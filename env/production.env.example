SYLVAN_BOT_IMAGE=ghcr.io/mathematics-discord/sylvan-bot:sha-your-tested-commit

DISCORD__TOKEN=production_bot_token_here
BRIDGE__CREDENTIAL=replace_with_a_random_bridge_credential
# The container listens on all interfaces; Compose publishes to host loopback only.
BRIDGE__ADDRESS=0.0.0.0
BRIDGE__PORT=8765
LOGGING__MAXCACHEDMESSAGECOUNT=500
LOGGING__MAXATTACHMENTCOUNTPERMESSAGE=4
LOGGING__MAXATTACHMENTBYTESPERATTACHMENT=8388608
LOGGING__MAXTOTALCACHEDATTACHMENTBYTES=67108864
LOGGING__METADATARETENTIONPERIOD=30.00:00:00
LOGGING__METADATACLEANUPINTERVAL=01:00:00

DB__DATABASE=sylvan-bot-production
DB__USER=sylvan-bot-production
DB__PASSWORD=change_this_production_db_password


ASPNETCORE_ENVIRONMENT=Production
