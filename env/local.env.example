# Copy this file to ../.env
ASPNETCORE_ENVIRONMENT=Development

# Use a separate Discord application/bot and development guild.
DISCORD__TOKEN=local_bot_token_here

# These values match the local PostgreSQL service in docker-compose.yml.
DB__HOST=localhost
DB__PORT=5432
DB__DATABASE=ratbot
DB__USER=postgres
DB__PASSWORD=postgres

# Leave unset unless running the optional local observability stack.
# OTEL__LOGS__ENDPOINT=http://localhost:4317
OTEL__LOGS__PROTOCOL=grpc
OTEL__RESOURCE__SERVICE_NAME=ratbot-local
OTEL__RESOURCE__ENVIRONMENT=development
