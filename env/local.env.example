# Copy this file to ../.env
ASPNETCORE_ENVIRONMENT=Development

# Use a separate Discord application/bot and development guild.
DISCORD__TOKEN=local_bot_token_here

# Generate a separate random credential (at least 32 characters) for Bridge clients.
BRIDGE__CREDENTIAL=replace_with_a_random_bridge_credential
BRIDGE__ADDRESS=127.0.0.1
BRIDGE__PORT=8765

# Optional: Bridge needs only these non-privileged intents, with no member download.
# Other features may need the legacy defaults; see docs/bridge.md.
# DISCORD__GATEWAYINTENTS=Guilds,GuildMessages
# DISCORD__ALWAYSDOWNLOADUSERS=false

# These values match the local PostgreSQL service in docker-compose.yml.
DB__HOST=localhost
DB__PORT=5432
DB__DATABASE=ratbot
DB__USER=postgres
DB__PASSWORD=postgres
