# Copy this file to ../.env
ASPNETCORE_ENVIRONMENT=Development

# Use a separate Discord application/bot and development guild.
DISCORD__TOKEN=local_bot_token_here
SYLVANMAIL__TOKEN=local_mail_bot_token_here
SYLVANMAIL__BOTID=your_local_mail_bot_id
DISCORD__MESSAGECACHESIZE=0

# These values match the local PostgreSQL service in docker-compose.yml.
DB__HOST=localhost
DB__PORT=5432
DB__DATABASE=sylvan-bot
DB__USER=postgres
DB__PASSWORD=postgres
